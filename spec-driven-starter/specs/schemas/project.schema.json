{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project",
  "title": "Project",
  "description": "A user-created project container",
  "type": "object",
  "required": ["id", "name", "createdAt"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
